                        {
                          "$type": "Models.Manager, Models",
                          "Code": "using APSIM.Shared.Utilities;\r\nusing Models.Utilities;\r\nusing Models.Soils;\r\nusing Models.PMF;\r\nusing Models.Core;\r\nusing System;\r\n\r\nnamespace Models\r\n{\r\n    [Serializable]\r\n    public class Script : Model\r\n    {\r\n        [Link] Plant Wheat;\r\n        [Link] private Clock Clock;\r\n        [Link] private Simulation sim;\r\n\r\n        [EventSubscribe(\"DoManagement\")]\r\n        private void OnDoManagement(object sender, EventArgs e)\r\n        {\r\n            if (Wheat.IsReadyForHarvesting)\r\n            {\r\n               Wheat.Harvest();\r\n               Wheat.EndCrop();  \r\n               sim.Set(\"Clock.EndDate\", Clock.Today.AddDays(1));  \r\n            }\r\n        \r\n        }\r\n        \r\n    }\r\n}\r\n",
                          "Parameters": [],
                          "Name": "Harvesting",
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
